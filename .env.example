# ==============================================================================
# GASSBot - Ghana Association of Statistics Students (KNUST)
# Official Environment Configuration Template
# "Statistics for Development"
# ==============================================================================

# Application Environment ('development' or 'production')
NODE_ENV=development

# Web Server Port (Render sets this dynamically in production)
PORT=3000

# Telegram Bot Token (obtained from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Bot Operation Mode:
# 'polling' - for local development / testing without a public domain
# 'webhook' - for production on Render (requires public HTTPS domain)
BOT_MODE=polling

# Production Webhook Configuration (required if BOT_MODE=webhook)
# Set this to your Render service URL (e.g. https://gassbot.onrender.com)
WEBHOOK_DOMAIN=https://your-service.onrender.com
WEBHOOK_PATH=/webhook

# Render PostgreSQL Connection String
# Example: postgres://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgres://user:pass@localhost:5432/gassbot

# Automatically run schema migrations on application startup
AUTO_MIGRATE=true

# Student Mini Web App URL (hosted on Vercel)
MINI_APP_URL=https://gassbot.vercel.app

# Authorized Administrator / Executive Telegram IDs (comma-separated)
# Students with these IDs will automatically have executive moderation privileges
ADMIN_TELEGRAM_IDS=123456789,987654321

# Modular AI Tutor Feature Flag (Set to true once Gemini API integration is active)
AI_ENABLED=false
